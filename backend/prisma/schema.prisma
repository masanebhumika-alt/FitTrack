generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int           @id @default(autoincrement())
  email       String        @unique
  passwordHash String
  createdAt   DateTime      @default(now())
  profile     Profile?
  fitnessPlan FitnessPlan?
  workouts    WorkoutPlan[]
  diets       DietPlan[]
  weights     WeightLog[]
  waters      WaterLog[]
  sleeps      SleepLog[]
  reminders   Reminder[]
}

model Profile {
  id              Int    @id @default(autoincrement())
  userId          Int    @unique
  name            String
  age             Int
  gender          String
  heightCm        Float
  weightKg        Float
  targetWeightKg  Float
  activityLevel   String
  user            User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FitnessPlan {
  id             Int    @id @default(autoincrement())
  userId         Int    @unique
  goal           String
  bmi            Float
  bmr            Float
  tdee           Float
  targetCalories Int
  proteinG       Int
  carbsG         Int
  fatG           Int
  updatedAt      DateTime @updatedAt
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WorkoutPlan {
  id         Int    @id @default(autoincrement())
  userId     Int
  dayOfWeek  Int
  title      String
  difficulty String
  exercises  Json
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, dayOfWeek])
}

model DietPlan {
  id         Int    @id @default(autoincrement())
  userId     Int
  mealType   String
  items      Json
  calories   Int
  proteinG   Int
  carbsG     Int
  fatG       Int
  user       User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, mealType])
}

model WeightLog {
  id       Int      @id @default(autoincrement())
  userId   Int
  date     DateTime @db.Date
  weightKg Float
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
}

model WaterLog {
  id       Int      @id @default(autoincrement())
  userId   Int
  date     DateTime @db.Date
  glasses  Int      @default(0)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
}

model SleepLog {
  id       Int      @id @default(autoincrement())
  userId   Int
  date     DateTime @db.Date
  hours    Float
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, date])
}

model Reminder {
  id      Int     @id @default(autoincrement())
  userId  Int
  type    String
  label   String
  time    String
  enabled Boolean @default(true)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
